{
  "name": "converse-spine",
  "version": "0.2.0",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "private": true,
  "type": "module",
  "description": "Production sales bot — deterministic turn spine + NayaDesk CRM",
  "scripts": {
    "demo": "tsx src/cli.ts",
    "chat": "tsx src/chat-repl.ts",
    "script": "tsx src/script-demo.ts",
    "eval:quality": "tsx src/eval/cli.ts",
    "eval:scenarios": "node scripts/with-env.mjs EVAL_MODE=scenarios -- tsx src/eval/cli.ts",
    "dev": "wrangler dev --env dev --port 8789",
    "deploy:dev": "wrangler deploy --env dev",
    "deploy:prod": "wrangler deploy --env prod",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:scenarios": "tsx scripts/run-buyer-scenarios.ts",
    "test:focus-hold": "vitest run tests/focus-hold-major-fix-regression.test.ts tests/pivot-arbiter.test.ts tests/bot-lane-a-b.test.ts",
    "test:focus-hold:live": "tsx scripts/run-focus-hold-regression.ts",
    "test:phase-0b": "vitest run tests/phase-0b-scenario-gate.test.ts tests/seams/ledger-truth.test.ts",
    "test:phase-0b:live": "tsx scripts/run-phase-0b-scenarios.ts",
    "test:unbound-name": "vitest run tests/unbound-name.test.ts",
    "test:unbound-name:report": "tsx scripts/run-unbound-name-scenarios.ts",
    "test:unbound-name:live": "tsx scripts/run-unbound-name-scenarios.ts --live",
    "test:name-06": "vitest run tests/name-06-sibling-switch.test.ts tests/name-evidence.test.ts",
    "test:other-one": "vitest run tests/other-one-deixis.test.ts tests/seams/entity-store.test.ts",
    "test:phase-1c": "vitest run tests/phase-1c-state-adversarial.test.ts tests/seams/entity-store.test.ts tests/other-one-deixis.test.ts tests/name-06-sibling-switch.test.ts tests/unbound-name.test.ts tests/nearby-offer.test.ts",
    "test:nearby-offer": "vitest run tests/nearby-offer.test.ts",
    "test:phase-2": "vitest run tests/phase-2-state-tokens.test.ts",
    "test:phase-1c:report": "tsx scripts/run-phase-1c-adversarial.ts",
    "test:probe": "tsx scripts/probe-project-vectors.ts",
    "test:embed-gate": "vitest run tests/embed-gate-second-tenant.test.ts",
    "smoke:p7": "bash scripts/smoke-p7-focused-chips.sh",
    "dev:local": "wrangler dev --env local --port 8789",
    "dev:remote": "wrangler dev --env local --port 8789",
    "soak:dig": "tsx scripts/run-dig-load-soak.ts",
    "board:latency": "tsx scripts/run-latency-scenario-board.ts"
  },
  "dependencies": {
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.14.0"
  }
}

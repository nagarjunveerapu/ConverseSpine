# No trailing slash: a worktree may symlink node_modules to the primary checkout,
# and `node_modules/` matches directories only, so `git add -A` would commit the symlink.
node_modules
data/*.db
data/*.db-*
dist/
eval-reports/
logs/
scenarios/runs/
.env
.dev.vars
.wrangler/

# macOS
.DS_Store
scripts/__pycache__/

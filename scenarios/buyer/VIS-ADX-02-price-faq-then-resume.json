{
  "id": "VIS-ADX-02",
  "title": "BREAK: propose → price → amenities → lock Monday 10am (stale Saturday must die)",
  "builder_id": "lokations",
  "tags": ["visit", "adversarial", "digression"],
  "turns": [
    { "text": "hi" },
    { "text": "plantation in sakleshpur" },
    { "text": "Ayana" },
    { "text": "I want to visit this weekend" },
    {
      "text": "Saturday morning",
      "assert": { "reply_includes_any": ["Saturday", "block", "confirm", "10"] }
    },
    {
      "text": "actually what is the price first",
      "assert": {
        "goal_kind_not": "visit_booked",
        "reply_excludes": ["which day", "what time"]
      }
    },
    {
      "text": "and any clubhouse or amenities?",
      "assert": {
        "goal_kind_not": "visit_booked",
        "reply_excludes": ["Shall I block *Saturday"]
      }
    },
    {
      "text": "ok lock Monday 10am for the visit",
      "assert": {
        "goal_kind_not": "unknown_request",
        "reply_includes_any": ["Monday", "10"],
        "reply_excludes": ["Saturday", "rephrase", "don't see a confirmed visit"]
      }
    }
  ]
}
